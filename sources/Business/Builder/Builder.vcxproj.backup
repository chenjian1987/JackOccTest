  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(JACKC_SOLUTION_BIN_DIR)\</OutDir>
    <IntDir>$(JACKC_BUILD_OUTPUT_DIR)\$(TargetName).dir\$(Configuration)\</IntDir>
    <TargetExt>.dll</TargetExt>
    <IncludePath>$(IncludePath)</IncludePath>
    <LibraryPath>$(LibraryPath)</LibraryPath>
    <LinkIncremental>true</LinkIncremental>
    <TargetName>JACKCC$(ProjectName)</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <AdditionalUsingDirectories>$(ArxSdkDir)\inc-$(Platform)</AdditionalUsingDirectories>
