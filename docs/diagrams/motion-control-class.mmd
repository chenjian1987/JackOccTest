direction TB

class MotionControlBusiness {
  +Create(context) bool
  +Initialize(context) bool
  +Load(context) bool
  +Save(context) bool
  +SetActiveWorkStation(id) bool
  +SetActiveDevice(id) bool
  +MoveDevice(command) bool
  +SimulateTrajectory(traj) bool
}

class WorkStationManager {
  -m_workStations
  -m_activeWorkStation
  +Add(ws) bool
  +Get(id) WorkStation
  +SetActive(id) bool
}

class WorkStation {
  -m_name : string
  -m_deviceGroups
  +AddDeviceGroup(group) bool
  +GetActiveDeviceGroup() DeviceGroup
}

class DeviceGroup {
  -m_devices
  -m_activeDevice
  +AddDevice(dev) bool
  +SetActiveDevice(id) bool
  +GetActiveDevice() Device
}

class Device {
  <<abstract>>
  +GetId() string
  +Initialize() bool
  +Move(command) bool
  +SetProperty(name,value) bool
}

class RobotDevice
class ExternalAxisDevice
class PositionerDevice
class WorkbenchDevice
class FixtureDevice

class Trajectory {
  +Append(point) bool
  +Count() int
}

class MotionCommand {
  +deviceId : string
  +targetPose
  +speed
  +acc
}

class SimulationController {
  +Initialize() bool
  +Play(traj) bool
  +Pause() bool
  +Stop() bool
}

class CollideChecker {
  +Initialize(scene) bool
  +CheckDevice(device) bool
  +CheckTrajectory(traj) bool
}

class RobotBaseAdapter {
  +ForwardKinematics(joints)
  +InverseKinematics(pose)
  +ValidatePose(pose) bool
}

class KinematicsService {
  +SolveFK(device, joints)
  +SolveIK(device, pose)
  +ValidateMotion(device, command) bool
}

MotionControlBusiness *-- WorkStationManager
