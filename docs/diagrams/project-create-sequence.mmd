User->>MainWindow: Click "New Project"
MainWindow->>CommandActionManager: Execute(Project.Create)
CommandActionManager->>ApplicationImpl: Open create workflow
ApplicationImpl->>Project: Create(projectRoot)
Project->>ProjectStorage: CreateDirectorySkeleton()
Project->>PreferenceManager: CreateDefaultProjectConfig()
Project->>BusinessManager: CreateAll(context)
BusinessManager->>MotionControlBusiness: Create(context)
BusinessManager->>ThreeDBusiness: Create(context)
BusinessManager->>DeviceCommBusiness: Create(context)
BusinessManager->>ProcessBusiness: Create(context)
BusinessManager->>PostProcessBusiness: Create(context)
BusinessManager->>WeldingAppBusiness: Create(context)
Project-->>ApplicationImpl: ProjectCreated
ApplicationImpl->>BusinessManager: InitializeAll(context)
BusinessManager->>MotionControlBusiness: Initialize(context)
BusinessManager->>ThreeDBusiness: Initialize(context)
BusinessManager->>DeviceCommBusiness: Initialize(context)
BusinessManager->>ProcessBusiness: Initialize(context)
BusinessManager->>PostProcessBusiness: Initialize(context)
BusinessManager->>WeldingAppBusiness: Initialize(context)
ApplicationImpl->>DocumentView: BindProject(project)
ApplicationImpl->>MainWindow: RefreshProjectState()
